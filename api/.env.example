# Postgres bağlantısı. Yerelde: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://journal:journal@localhost:5432/trading_journal?sslmode=disable

# Web uygulamasının dışarıdan görünen adresi. Google dönüş adresi ve çerezin
# Secure bayrağı bundan türetilir.
APP_URL=http://localhost:3000

# false: yeni hesap açılamaz, yalnız mevcut hesaplar girer.
ALLOW_SIGNUP=true

# İsteğe bağlı — Google ile giriş. Redirect URI: <APP_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yüklenen görsellerin klasörü
UPLOAD_DIR=./data/uploads

PORT=8080
APP_TIMEZONE=Europe/Istanbul
SESSION_TTL_DAYS=30
