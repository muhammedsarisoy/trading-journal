# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Go API adresi
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google ile giriş — Supabase > Authentication > Providers > Google
# Bu iki değer .env dosyasına DEĞİL, Supabase panosuna girilir; uygulama
# bunları okumaz, jetonu Supabase üretir.
#   GOOGLE_CLIENT_ID     = <...>.apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET = <google-client-secret>
#
# Google Cloud > APIs & Services > Credentials > OAuth client
#   Authorized redirect URI: https://<proje-ref>.supabase.co/auth/v1/callback
#
# Supabase > Authentication > URL Configuration
#   Site URL:      http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
#                  https://<alan-adın>/auth/callback
