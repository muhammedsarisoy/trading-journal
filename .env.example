# docker-compose.yml için. Coolify'da bu değerleri
# Environment Variables ekranına gir; dosya gerekmez.

# Veritabanı parolası — yalnız harf ve rakam, en az 24 karakter.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Uygulamanın dışarıdan görünen adresi (sonda / yok).
APP_URL=https://journal.alanadin.com

# Hesabını açtıktan sonra false yap: alan adını bilen başkası kayıt olamasın.
ALLOW_SIGNUP=true

# İsteğe bağlı — Google ile giriş. Google Cloud Console > Credentials >
# OAuth client ID (Web application). Authorized redirect URI:
#   <APP_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_TIMEZONE=Europe/Istanbul
